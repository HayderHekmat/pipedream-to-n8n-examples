{
  "name": "Signed Webhook to Sheets",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 360],
      "webhookId": "example-webhook-id",
      "parameters": {
        "path": "github-push",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "2",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 360],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\n\nconst item = $input.first();\nconst headers = item.json?.headers || {};\nconst signature = headers['x-hub-signature-256'] || headers['X-Hub-Signature-256'];\nconst parsedBody = item.json?.body;\n\nlet secret;\ntry {\n  secret = $env.GITHUB_WEBHOOK_SECRET;\n} catch (e) {\n  secret = undefined;\n}\n\nif (!secret) {\n  return [{\n    json: {\n      verified: false,\n      error: 'GITHUB_WEBHOOK_SECRET is not set (fail closed). Configure the env var and set N8N_BLOCK_ENV_ACCESS_IN_NODE=false.',\n      headers,\n      body: parsedBody,\n    },\n  }];\n}\n\nconst binary = item.binary?.data;\nif (!binary?.data) {\n  return [{\n    json: {\n      verified: false,\n      error: 'Missing raw body binary data. Enable the Webhook node rawBody option (bytes land in binary.data, not json.body).',\n      headers,\n      body: parsedBody,\n    },\n  }];\n}\n\nconst rawBody = Buffer.from(binary.data, 'base64');\n\nif (!signature) {\n  return [{\n    json: {\n      verified: false,\n      error: 'Missing x-hub-signature-256 header',\n      headers,\n      body: parsedBody,\n    },\n  }];\n}\n\nconst digest = crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\nconst expected = `sha256=${digest}`;\n\nlet isValid = false;\ntry {\n  const sigBuf = Buffer.from(String(signature));\n  const expectedBuf = Buffer.from(expected);\n  if (sigBuf.length === expectedBuf.length) {\n    isValid = crypto.timingSafeEqual(sigBuf, expectedBuf);\n  }\n} catch (e) {\n  isValid = false;\n}\n\nreturn [{\n  json: {\n    verified: isValid,\n    error: isValid ? undefined : 'Invalid signature',\n    headers,\n    body: parsedBody,\n  },\n}];"
      }
    },
    {
      "id": "3",
      "name": "Check Signature",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [680, 360],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.verified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Transform Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 260],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $input.first().json;\nconst headers = payload.headers || {};\nlet event = payload.body;\n\nif (typeof event === 'string') {\n  try {\n    event = JSON.parse(event);\n  } catch (e) {\n    event = {};\n  }\n}\nif (!event || typeof event !== 'object') {\n  event = {};\n}\n\nconst eventId = headers['x-github-delivery'] || headers['X-GitHub-Delivery'];\nif (!eventId) {\n  throw new Error('Missing x-github-delivery header; refusing to invent an event_id');\n}\n\nreturn [{\n  json: {\n    event_id: eventId,\n    repository: event.repository?.full_name || 'unknown',\n    pusher: event.pusher?.name || event.pusher?.email || 'unknown',\n    ref: event.ref || 'unknown',\n    commits_count: Array.isArray(event.commits) ? event.commits.length : 0,\n    timestamp: new Date().toISOString(),\n    url: event.compare || event.repository?.html_url || '',\n  },\n}];"
      }
    },
    {
      "id": "5",
      "name": "Write to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1120, 260],
      "parameters": {
        "authentication": "oAuth2",
        "resource": "sheet",
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "event_id": "={{ $json.event_id }}",
            "repository": "={{ $json.repository }}",
            "pusher": "={{ $json.pusher }}",
            "ref": "={{ $json.ref }}",
            "commits_count": "={{ $json.commits_count }}",
            "timestamp": "={{ $json.timestamp }}",
            "url": "={{ $json.url }}"
          },
          "matchingColumns": ["event_id"],
          "schema": [
            { "id": "event_id", "displayName": "event_id", "required": false, "defaultMatch": true, "display": true, "type": "string", "canBeUsedToMatch": true, "removed": false },
            { "id": "repository", "displayName": "repository", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true, "removed": false },
            { "id": "pusher", "displayName": "pusher", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true, "removed": false },
            { "id": "ref", "displayName": "ref", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true, "removed": false },
            { "id": "commits_count", "displayName": "commits_count", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true, "removed": false },
            { "id": "timestamp", "displayName": "timestamp", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true, "removed": false },
            { "id": "url", "displayName": "url", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true, "removed": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {
          "useAppend": true
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": null,
          "name": "Google Sheets OAuth2 API"
        }
      }
    },
    {
      "id": "6",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1340, 260],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"event_id\": $json.event_id, \"action\": \"processed\" } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "7",
      "name": "Respond Invalid Signature",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [900, 460],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"error\": \"Invalid signature\" } }}",
        "options": {
          "responseCode": 401
        }
      }
    }
  ],
  "connections": {
