          "name": "Stripe API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract payment details from Stripe webhook\n// Defensive checks for missing data\nconst inputData = $input.item.json;\n\nif (!inputData.data || !inputData.data.object) {\n  throw new Error(\n    'Invalid Stripe event structure: missing data.object. ' +\n    'Expected a Stripe webhook event with structure: { data: { object: { ...PaymentIntent } } }. ' +\n    'Received: ' + JSON.stringify(inputData).substring(0, 200)\n  );\n}\n\nconst paymentIntent = inputData.data.object;\n\n// Validate required fields\nif (!paymentIntent.id || !paymentIntent.amount || !paymentIntent.currency || !paymentIntent.status) {\n  throw new Error(\n    'Missing required PaymentIntent fields (id, amount, currency, or status). ' +\n    'Received PaymentIntent: ' + JSON.stringify(paymentIntent).substring(0, 200)\n  );\n}\n\n// Extract key details\nconst amount = paymentIntent.amount; // Amount in cents\nconst currency = paymentIntent.currency.toUpperCase();\nconst customerEmail = paymentIntent.receipt_email || \n                       paymentIntent.charges?.data?.[0]?.billing_details?.email || \n                       'N/A';\nconst paymentId = paymentIntent.id;\nconst status = paymentIntent.status;\n\n// Format amount (convert cents to dollars/euros/etc)\nconst formattedAmount = (amount / 100).toFixed(2);\n\n// Return formatted data for next node\nreturn {\n  json: {\n    amount: formattedAmount,\n    currency: currency,\n    customerEmail: customerEmail,\n    paymentId: paymentId,\n    status: status,\n    dashboardUrl: `https://dashboard.stripe.com/payments/${paymentId}`\n  }\n};"
      },
      "id": "2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Format Payment Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C01234567",
          "mode": "list",
          "cachedResultName": "#payments"
        },
        "messageType": "text",
        "text": "=✅ New Payment Received!\n\n*Amount:* ${{ $json.amount }} {{ $json.currency }}\n*Customer Email:* {{ $json.customerEmail }}\n*Payment ID:* {{ $json.paymentId }}\n*Status:* {{ $json.status }}\n\nView in Stripe Dashboard: {{ $json.dashboardUrl }}",
        "otherOptions": {}
      },
      "id": "3c4d5e6f-7a8b-9c0d-1e2f-3a4b5c6d7e8f",
